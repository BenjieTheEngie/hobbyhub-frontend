{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PreviewOnlySandboxStripeLedgerCloudFormationChangeSet",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:ListStackResources",
        "cloudformation:GetTemplate"
      ],
      "Resource": "arn:aws:cloudformation:us-east-2:349744180170:stack/hobbyhub-stripe-sandbox-ledgers/*"
    },
    {
      "Sid": "PassOnlyRestrictedLedgerExecutionRoleToCloudFormation",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::349744180170:role/HobbyHubStagingLedgerCfnExec",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
