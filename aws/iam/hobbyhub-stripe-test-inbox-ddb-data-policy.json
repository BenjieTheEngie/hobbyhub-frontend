{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTestStripeEventIdSingleItemReadAndConditionalApplicationWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:349744180170:table/hobbyhub-stripe-sandbox-ledgers-StripeTestEventLedger-1TS67SSV8ILV5",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "evt_*"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        }
      }
    }
  ]
}
